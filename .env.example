JWT_SECRET=dev-secret-change-in-production-use-64-char-random-string
AGENT_AUTH_TOKEN=dev-agent-token
PUBLIC_IP=REDACTED_IP
SERVER_HOSTNAME=linuxdesktop
SERVER_REGION=sa
SERVER_CITY=local
SERVER_COUNTRY=AR
MANAGER_ENDPOINT=http://127.0.0.1:8082

# Leave BTCPAY_API_KEY empty and set ALLOW_MOCK_BTCPAY=true for local mock checkout.
# Public hosts must omit ALLOW_MOCK_BTCPAY (or set false) and configure real BTCPAY_*.
# Production (ENVIRONMENT=production) requires real BTCPAY_* including WEBHOOK_SECRET;
# mock routes are disabled and unsigned webhooks are rejected.
ALLOW_MOCK_BTCPAY=true
BTCPAY_SERVER_URL=http://localhost:49392
BTCPAY_API_KEY=
BTCPAY_STORE_ID=
BTCPAY_WEBHOOK_SECRET=
BTCPAY_PUBLIC_URL=https://btcpay.veritasvpn.cloud

# Optional: restrict Free peers to these region codes (comma-separated). Empty = any online.
FREE_ALLOWED_REGIONS=
PREMIUM_PRICE_USD_CENTS=500
PREMIUM_PERIOD_DAYS=30
CHECKOUT_SUCCESS_URL=http://localhost:8000/billing/success.html
CHECKOUT_CANCEL_URL=http://localhost:8000/billing/cancel.html
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
BILLING_PUBLIC_URL=http://localhost:8083
