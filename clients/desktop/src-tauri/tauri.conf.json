{
  "$schema": "https://raw.githubusercontent.com/nicholas/tauri/refs/heads/v2/crates/tauri-config-schema/schema.json",
  "productName": "VeritasVPN",
  "version": "0.1.0",
  "identifier": "cloud.veritasvpn.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "VeritasVPN",
        "width": 400,
        "height": 560,
        "resizable": true,
        "maximizable": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src https://veritasvpn.cloud https://api.veritasvpn.cloud https://fonts.googleapis.com https://fonts.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:",
      "useHttpsScheme": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/bin/**/*"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "linux": {}
  }
}
